---
import type { Locale } from "../i18n/ui";
import {
  t,
  localePath,
  locales,
  localeNames,
  githubUrl,
  siteName,
  ogLocale,
} from "../i18n/ui";
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const canonical = new URL(localePath(locale), Astro.site).href;
// Static share image in public/ — no runtime OG generation (Satori, etc.).
const ogImagePath = "/og.png";
const ogImage = new URL(ogImagePath, Astro.site);
const ogImageWidth = 1200;
const ogImageHeight = 630;
const themeColor = "#ffffff";

const alternateLocales = locales.filter((l) => l !== locale);

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${Astro.site}#website`,
      url: Astro.site?.href,
      name: siteName,
      description: copy.meta.description,
      inLanguage: locale,
      publisher: { "@id": `${Astro.site}#organization` },
    },
    {
      "@type": "Organization",
      "@id": `${Astro.site}#organization`,
      name: siteName,
      url: Astro.site?.href,
      sameAs: [githubUrl],
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${Astro.site}#app`,
      name: siteName,
      description: copy.meta.description,
      url: Astro.site?.href,
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Android",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "EUR",
      },
      isAccessibleForFree: true,
      license: "https://opensource.org/licenses/MIT",
      downloadUrl: githubUrl,
      inLanguage: ["es", "ca", "en"],
      author: {
        "@type": "Person",
        name: "Pablo Vallejo",
      },
    },
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content={themeColor} />
    <title>{copy.meta.title}</title>
    <meta name="description" content={copy.meta.description} />
    <link rel="canonical" href={canonical} />
    {
      locales.map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(localePath(l), Astro.site).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath("es"), Astro.site).href}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={copy.meta.title} />
    <meta property="og:description" content={copy.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {
      alternateLocales.map((l) => (
        <meta property="og:locale:alternate" content={ogLocale[l]} />
      ))
    }
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={copy.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={copy.meta.title} />
    <meta name="twitter:description" content={copy.meta.description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content={copy.meta.ogAlt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/mulish-variable.ttf" as="font" type="font/ttf" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#contenido">{copy.nav.skip}</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="site-logo" href={localePath(locale)} aria-label="Puente">
          <img src="/favicon.svg" alt="" width="34" height="34" />
          <span>Puente</span>
        </a>
        <nav class="section-nav" aria-label={copy.nav.label}>
          <a href="#como-funciona">{copy.nav.how}</a>
          <a href="#privacidad">{copy.nav.privacy}</a>
          <a href="#proyecto">{copy.nav.project}</a>
        </nav>
        <nav class="site-nav" aria-label={copy.nav.langLabel}>
          <ul class="lang-switch" role="list">
            {
              locales.map((l) => (
                <li>
                  <a
                    href={localePath(l)}
                    hreflang={l}
                    aria-current={l === locale ? "page" : undefined}
                  >
                    {localeNames[l]}
                  </a>
                </li>
              ))
            }
          </ul>
          <a class="nav-code" href={githubUrl} rel="noopener noreferrer" target="_blank">
            <span>{copy.nav.code}</span>
            <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <div class="site-footer__identity">
          <a class="site-logo site-logo--footer" href={localePath(locale)}>
            <img src="/favicon.svg" alt="" width="42" height="42" />
            <span>Puente</span>
          </a>
          <p>{copy.footer.tagline}</p>
        </div>
        <div class="site-footer__meta">
          <p>{copy.footer.by}</p>
          <p>
            <a href={githubUrl} rel="noopener noreferrer" target="_blank">{copy.footer.license}</a>
            · {copy.footer.rights}
          </p>
          <ul class="lang-switch lang-switch--footer" role="list">
            {
              locales.map((l) => (
                <li>
                  <a
                    href={localePath(l)}
                    hreflang={l}
                    aria-current={l === locale ? "page" : undefined}
                  >
                    {localeNames[l]}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header { position: sticky; top: 0; z-index: 20; background: rgb(255 255 255 / 96%); border-bottom: 1px solid var(--line); }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 5.5rem; }
  .site-logo { display: inline-flex; align-items: center; gap: .6rem; font-weight: 800; font-size: 1.55rem; letter-spacing: -.06em; text-decoration: none; }
  .site-logo img { width: 2.4rem; height: 2.4rem; }
  .section-nav { display: flex; align-items: center; gap: 2.25rem; }
  .section-nav a { padding-block: .65rem; font-size: .8rem; font-weight: 600; text-decoration: none; color: var(--muted); }
  .section-nav a:hover { color: var(--brown); }
  .site-nav { display: flex; align-items: center; gap: 1.4rem; }
  .lang-switch { display: flex; gap: .1rem; margin: 0; padding: 0; list-style: none; }
  .lang-switch a { display: grid; min-width: 2rem; min-height: 2.75rem; place-items: center; text-decoration: none; font-size: .67rem; font-weight: 600; color: var(--muted); }
  .lang-switch a[aria-current="page"] { color: var(--brown); font-weight: 800; text-decoration: underline; text-underline-offset: .4em; }
  .lang-switch a:hover { color: var(--brown); background: var(--tint); }
  .nav-code { display: inline-flex; align-items: center; gap: .85rem; min-height: 2.6rem; padding-inline: 1rem; border: 1px solid var(--line); border-radius: 4px; font-size: .75rem; font-weight: 700; text-decoration: none; }
  .nav-code:hover { background: var(--tint); border-color: var(--brown); }
  .site-footer { padding-block: 2.5rem; border-top: 1px solid var(--line); }
  .site-footer__inner { display: flex; justify-content: space-between; align-items: center; gap: 2rem; }
  .site-footer p { margin: .5rem 0 0; font-size: .75rem; color: var(--muted); }
  .site-logo--footer { font-size: 1.3rem; }
  .site-footer__meta { text-align: right; }
  .site-footer__meta a { text-underline-offset: .25em; }
  .lang-switch--footer { justify-content: flex-end; margin-top: .6rem; }
  @media (max-width: 900px) { .section-nav { gap: 1.25rem; } .site-nav { gap: .65rem; } }
  @media (max-width: 760px) { .section-nav { display: none; } .site-header__inner { min-height: 4.5rem; } }
  @media (max-width: 400px) { .site-header__inner { gap: .5rem; } .site-logo { font-size: 1.3rem; gap: .3rem; } .site-logo img { width: 2rem; height: 2rem; } .nav-code { padding-inline: .6rem; gap: .4rem; } .site-nav { gap: .4rem; } .lang-switch a { min-width: 1.65rem; } }
  @media (max-width: 520px) { .site-footer__inner { align-items: start; flex-direction: column; } .site-footer__meta { text-align: left; } .lang-switch--footer { justify-content: flex-start; } }
</style>
