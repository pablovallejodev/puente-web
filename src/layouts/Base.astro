---
import type { Locale } from "../i18n/ui";
import {
  t,
  localePath,
  locales,
  localeNames,
  githubUrl,
  siteName,
  ogLocale,
} from "../i18n/ui";
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const canonical = new URL(localePath(locale), Astro.site).href;
// Static share image in public/ — no runtime OG generation (Satori, etc.).
const ogImagePath = "/og.png";
const ogImage = new URL(ogImagePath, Astro.site);
const ogImageWidth = 1200;
const ogImageHeight = 630;
const themeColor = "#f2f6d0";

const alternateLocales = locales.filter((l) => l !== locale);

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${Astro.site}#website`,
      url: Astro.site?.href,
      name: siteName,
      description: copy.meta.description,
      inLanguage: locale,
      publisher: { "@id": `${Astro.site}#organization` },
    },
    {
      "@type": "Organization",
      "@id": `${Astro.site}#organization`,
      name: siteName,
      url: Astro.site?.href,
      sameAs: [githubUrl],
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${Astro.site}#app`,
      name: siteName,
      description: copy.meta.description,
      url: Astro.site?.href,
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Android",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "EUR",
      },
      isAccessibleForFree: true,
      license: "https://opensource.org/licenses/MIT",
      downloadUrl: githubUrl,
      inLanguage: ["es", "ca", "en"],
      author: {
        "@type": "Person",
        name: "Pablo Vallejo",
      },
    },
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content={themeColor} />
    <title>{copy.meta.title}</title>
    <meta name="description" content={copy.meta.description} />
    <link rel="canonical" href={canonical} />
    {
      locales.map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(localePath(l), Astro.site).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath("es"), Astro.site).href}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={copy.meta.title} />
    <meta property="og:description" content={copy.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {
      alternateLocales.map((l) => (
        <meta property="og:locale:alternate" content={ogLocale[l]} />
      ))
    }
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={copy.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={copy.meta.title} />
    <meta name="twitter:description" content={copy.meta.description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content={copy.meta.ogAlt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Mulish:wght@500;700;800;900&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <Analytics />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <a class="skip-link" href="#contenido">{copy.nav.skip}</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="site-logo" href={localePath(locale)} aria-label="Puente">
          <img src="/favicon.svg" alt="" width="34" height="34" />
          <span>Puente</span>
        </a>
        <nav class="site-nav" aria-label={copy.nav.langLabel}>
          <ul class="lang-switch" role="list">
            {
              locales.map((l) => (
                <li>
                  <a
                    href={localePath(l)}
                    hreflang={l}
                    aria-current={l === locale ? "page" : undefined}
                  >
                    {localeNames[l]}
                  </a>
                </li>
              ))
            }
          </ul>
          <a class="nav-code" href={githubUrl} rel="noopener noreferrer" target="_blank">
            <span>{copy.nav.code}</span>
            <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <div class="site-footer__identity">
          <a class="site-logo site-logo--footer" href={localePath(locale)}>
            <img src="/favicon.svg" alt="" width="42" height="42" />
            <span>Puente</span>
          </a>
          <p>{copy.hero.slogan}</p>
        </div>
        <div class="site-footer__meta">
          <p>{copy.footer.by}</p>
          <p>
            <a href={githubUrl} rel="noopener noreferrer" target="_blank">{copy.footer.license}</a>
            · {copy.footer.rights}
          </p>
          <ul class="lang-switch lang-switch--footer" role="list">
            {
              locales.map((l) => (
                <li>
                  <a
                    href={localePath(l)}
                    hreflang={l}
                    aria-current={l === locale ? "page" : undefined}
                  >
                    {localeNames[l]}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0.75rem;
    z-index: 40;
    padding-inline: var(--pad);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(100%, var(--max));
    padding: 0.55rem 0.65rem 0.55rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--cream) 84%, transparent);
    box-shadow: 0 0.75rem 2.5rem color-mix(in srgb, var(--ink) 9%, transparent);
    backdrop-filter: blur(18px) saturate(115%);
    -webkit-backdrop-filter: blur(18px) saturate(115%);
  }

  .site-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-weight: 800;
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
  }

  .site-logo img {
    width: 2rem;
    height: 2rem;
    border-radius: 0.55rem;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(0.55rem, 2vw, 1.15rem);
  }

  .lang-switch {
    display: flex;
    gap: 0.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lang-switch a {
    display: grid;
    min-width: 2rem;
    min-height: 2rem;
    place-items: center;
    border-radius: 0.55rem;
    text-decoration: none;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--dim-grey);
    transition:
      color 180ms var(--ease),
      background-color 180ms var(--ease);
  }

  .lang-switch a[aria-current="page"],
  .lang-switch a:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--sand-dune) 65%, transparent);
  }

  .nav-code {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.3rem;
    padding-inline: 0.9rem;
    border-radius: 0.7rem;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--cream);
    background: var(--ink);
    transition:
      transform 180ms var(--ease),
      background-color 180ms var(--ease);
  }

  .nav-code:hover {
    transform: translateY(-1px);
    background: var(--dim-grey);
  }

  .site-footer {
    padding-block: clamp(3rem, 7vw, 5rem);
    color: var(--cream);
    background: var(--ink);
  }

  .site-footer__inner {
    display: grid;
    gap: 2.5rem;
  }

  .site-footer p {
    margin: 0;
    font-size: 0.9rem;
    color: color-mix(in srgb, var(--cream) 68%, transparent);
  }

  .site-footer a {
    text-decoration: none;
  }

  .site-logo--footer {
    margin-bottom: 1rem;
    color: var(--cream);
  }

  .site-footer__meta {
    display: grid;
    gap: 0.45rem;
  }

  .site-footer__meta > p a {
    color: var(--cream);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .lang-switch--footer {
    margin-top: 1rem;
  }

  .lang-switch--footer a {
    color: color-mix(in srgb, var(--cream) 68%, transparent);
  }

  .lang-switch--footer a[aria-current="page"],
  .lang-switch--footer a:hover {
    color: var(--cream);
    background: color-mix(in srgb, var(--cream) 10%, transparent);
  }

  @media (min-width: 700px) {
    .site-footer__inner {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .site-footer__meta {
      justify-items: end;
      text-align: right;
    }
  }

  @media (max-width: 520px) {
    .site-header {
      top: 0.5rem;
      padding-inline: 0.65rem;
    }

    .site-header__inner {
      padding-left: 0.55rem;
    }

    .site-logo {
      gap: 0.45rem;
    }

    .site-logo img {
      width: 1.8rem;
      height: 1.8rem;
    }

    .nav-code {
      min-height: 2.2rem;
      padding-inline: 0.75rem;
    }

    .site-nav {
      gap: 0.35rem;
    }

    .lang-switch a {
      min-width: 1.8rem;
    }
  }

  @media (max-width: 390px) {
    .site-header .site-logo span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
</style>
