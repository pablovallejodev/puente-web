---
import type { Locale } from "../i18n/ui";
import { t, githubUrl } from "../i18n/ui";
import Base from "../layouts/Base.astro";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = t(locale);
const icons = [
  "M3 8a15 15 0 0 1 18 0M6 12a10 10 0 0 1 12 0M9 16a5 5 0 0 1 6 0M12 20h.01M3 3l18 18",
  "M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6l-8-3Zm-4 9 3 3 5-6",
  "M20 12v8H4v-8M2 8h20v4H2zM12 8v12M12 8H7a3 3 0 1 1 3-3l2 3Zm0 0h5a3 3 0 1 0-3-3l-2 3Z",
  "m8 7-5 5 5 5m8-10 5 5-5 5m-3-13-2 16",
];
---

<Base locale={locale}>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero__intro">
      <div>
        <p class="eyebrow">{copy.hero.eyebrow}</p>
        <h1 id="hero-title">{copy.hero.title}<br /><span>{copy.hero.accent}</span></h1>
      </div>
      <div class="hero__copy">
        <p class="hero__lead">{copy.hero.lead}</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="#como-funciona">{copy.hero.cta}<span aria-hidden="true">↓</span></a>
          <a class="text-link" href={githubUrl} target="_blank" rel="noopener noreferrer">{copy.hero.secondary}<span aria-hidden="true">↗</span></a>
        </div>
        <p class="hero__availability">{copy.hero.availability}</p>
      </div>
    </div>
    <figure class="hero__figure">
      <div class="hero__landscape">
        <img src="/images/puente-1440.webp" srcset="/images/puente-640.webp 640w, /images/puente-960.webp 960w, /images/puente-1440.webp 1440w, /images/puente-1881.webp 1881w" alt={copy.hero.imageAlt} width="1881" height="836" sizes="(max-width: 1400px) 90vw, 1232px" loading="eager" fetchpriority="high" class="hero__image" />
        <aside class="conversation" aria-label={copy.hero.example}>
          <div class="conversation__top"><span class="conversation__brand">Puente</span><span class="conversation__offline"><span></span>{copy.hero.offline}</span></div>
          <div class="conversation__phrase"><span class="conversation__language">{copy.hero.from}</span><p lang={locale}>{copy.hero.source}</p></div>
          <div class="conversation__translation"><span class="conversation__language">{copy.hero.to}<span aria-hidden="true">↳</span></span><p lang={locale === "en" ? "es" : "en"}>{copy.hero.translation}</p></div>
          <div class="conversation__bottom"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 11V7a4 4 0 0 1 8 0v4M6 11h12v10H6zM12 15v2" /></svg>{copy.hero.private}<span class="conversation__wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span></div>
          <span class="conversation__example">{copy.hero.exampleLabel}</span>
        </aside>
      </div>
      <figcaption><span>{copy.hero.caption}</span><span>{copy.hero.captionEnd}</span></figcaption>
    </figure>
    <ul class="proofs" role="list">
      {copy.hero.proofs.map((proof, i) => <li><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d={icons[i]} /></svg>{proof}</li>)}
    </ul>
  </section>

  <section class="section features wrap" aria-labelledby="features-title">
    <div class="section-heading">
      <div><p class="eyebrow">{copy.features.eyebrow}</p><h2 id="features-title">{copy.features.title}</h2></div>
      <p class="section-heading__lead">{copy.features.lead}</p>
    </div>
    <div class="features__grid">
      {copy.features.items.map((item, i) => <article class="feature">
        <span class="feature__icon" aria-hidden="true">{i === 0 ? <svg class="icon" viewBox="0 0 24 24"><path d="M4 10v4m4-8v12m4-15v18m4-15v12m4-8v4" /></svg> : i === 1 ? <svg class="icon" viewBox="0 0 24 24"><path d={icons[0]} /></svg> : <svg class="icon" viewBox="0 0 24 24"><path d="M3 5h12M9 3v2m4 0c-1 7-5 10-10 12m2-9c1 4 4 7 8 9m0 4 4-11 4 11m-6.5-4h5" /></svg>}</span>
        <h3>{item.title}</h3><p>{item.body}</p>
      </article>)}
    </div>
  </section>

  <section class="how" id="como-funciona" aria-labelledby="how-title">
    <div class="wrap section">
      <div class="section-heading"><div><p class="eyebrow">{copy.how.eyebrow}</p><h2 id="how-title">{copy.how.title}</h2></div><p class="section-heading__lead">{copy.how.lead}</p></div>
      <ol class="steps">
        {copy.how.steps.map(step => <li><span class="steps__n" aria-hidden="true">{step.n}</span><h3>{step.title}</h3><p>{step.body}</p></li>)}
      </ol>
      <p class="how__note">{copy.how.note}</p>
    </div>
  </section>

  <section class="section privacy wrap" id="privacidad" aria-labelledby="privacy-title">
    <div class="privacy__visual">
      <div class="privacy__device">
        <span class="privacy__speaker" aria-hidden="true"></span>
        <div class="privacy__device-top"><span>Puente</span><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d={icons[1]} /></svg></div>
        <div class="privacy__lock" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><path d="M15 22v-8a9 9 0 0 1 18 0v8M12 22h24v19H12zM24 29v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
        <p>{copy.privacy.visualTitle}</p><span class="privacy__device-note">{copy.privacy.visualNote}</span>
        <div class="privacy__audio" aria-hidden="true">{[8, 16, 11, 27, 39, 23, 14, 31, 45, 26, 16, 34, 21, 12, 18, 8].map(height => <i style={`height: ${height}px`}></i>)}</div>
        <span class="privacy__home" aria-hidden="true"></span>
      </div>
      <p class="privacy__visual-caption"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>{copy.privacy.status}</p>
    </div>
    <div class="privacy__copy"><p class="eyebrow">{copy.privacy.eyebrow}</p><h2 id="privacy-title">{copy.privacy.title}</h2><p class="body-copy">{copy.privacy.body}</p>
      <ul class="privacy__points" role="list">{copy.privacy.points.map(point => <li><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>{point}</li>)}</ul>
    </div>
  </section>

  <section class="community wrap" id="proyecto" aria-labelledby="community-title">
    <div class="community__intro"><p class="eyebrow">{copy.community.eyebrow}</p><h2 id="community-title">{copy.community.title}</h2><span class="community__license"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d={icons[3]} /></svg>{copy.community.license}</span></div>
    <div class="community__copy"><p>{copy.community.body}</p><p>{copy.community.detail}</p><a class="text-link" href={githubUrl} target="_blank" rel="noopener noreferrer">{copy.community.cta}<span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="section faq wrap" aria-labelledby="faq-title">
    <h2 id="faq-title">{copy.faq.title}</h2>
    <div class="faq__items">{copy.faq.items.map(item => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div>
  </section>

  <section class="closing" aria-labelledby="closing-title"><div class="wrap closing__inner">
    <div><p class="eyebrow">PUENTE</p><h2 id="closing-title">{copy.closing.title}</h2><p>{copy.closing.body}</p></div>
    <div class="closing__action"><a class="btn btn--primary" href={githubUrl} target="_blank" rel="noopener noreferrer">{copy.closing.cta}<span aria-hidden="true">↗</span></a><span>{copy.closing.note}</span></div>
  </div></section>
</Base>

<style>
  .hero { padding-top: clamp(3rem, 5.5vw, 5.25rem); }
  .hero__intro { display: grid; grid-template-columns: 1.35fr 1fr; gap: 3rem; align-items: center; margin-bottom: 2.75rem; }
  h1 { margin: 0; font-size: clamp(2.8rem, 4.75vw, 4.65rem); line-height: 1.12; font-weight: 600; letter-spacing: -.055em; }
  h1 span { color: var(--brown); }
  .hero__copy { padding-top: 1.75rem; }
  .hero__lead { max-width: 28rem; margin-bottom: 1.5rem; font-size: clamp(1rem, 1.3vw, 1.12rem); line-height: 1.8; color: var(--muted); }
  .hero__actions { display: flex; align-items: center; flex-wrap: wrap; gap: .5rem 1.5rem; }
  .hero__availability { margin: .9rem 0 0; font-size: .67rem; color: var(--muted); }
  .hero__figure { margin: 0; }
  .hero__landscape { position: relative; height: clamp(22rem, 30vw, 27rem); border-radius: 7px; }
  .hero__image { width: 100%; height: 100%; object-fit: cover; object-position: 50% 54%; border-radius: inherit; }
  .hero__figure figcaption { display: flex; justify-content: space-between; gap: 1rem; margin-top: .75rem; font-size: .65rem; color: var(--muted); }
  .conversation { position: absolute; bottom: 1.6rem; right: 1.6rem; width: 17rem; padding: 1.2rem 1.35rem .9rem; border: 1px solid rgb(255 255 255 / 70%); border-radius: 9px; background: rgb(255 255 255 / 97%); box-shadow: 0 8px 35px #17261f20; }
  .conversation__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.15rem; }
  .conversation__brand { font-size: .95rem; font-weight: 800; letter-spacing: -.05em; }
  .conversation__offline { display: flex; align-items: center; gap: .35rem; font-size: .57rem; color: #56654f; }
  .conversation__offline > span { width: 5px; height: 5px; border-radius: 50%; background: #697d61; }
  .conversation__language { display: flex; align-items: center; justify-content: space-between; font-size: .6rem; color: var(--muted); }
  .conversation__phrase p, .conversation__translation p { margin: .2rem 0 0; font-size: 1rem; font-weight: 600; letter-spacing: -.025em; }
  .conversation__translation { margin-top: .85rem; padding: .8rem .9rem; background: #f3eee8; border-radius: 4px; color: var(--brown-dark); }
  .conversation__bottom { display: flex; align-items: center; gap: .35rem; margin-top: 1rem; color: var(--muted); font-size: .55rem; }
  .conversation__bottom .icon { width: .85rem; height: .85rem; }
  .conversation__wave { display: flex; align-items: center; gap: 2px; margin-left: auto; height: 18px; }
  .conversation__wave i { width: 2px; height: 5px; border-radius: 1px; background: var(--brown); }
  .conversation__wave i:nth-child(2n) { height: 12px; }
  .conversation__wave i:nth-child(3) { height: 18px; }
  .conversation__example { display: block; margin-top: .65rem; font-size: .5rem; color: var(--muted); }
  .proofs { display: grid; grid-template-columns: repeat(4, 1fr); margin: 2rem 0 0; padding: 1.5rem 0; list-style: none; border-block: 1px solid var(--line); }
  .proofs li { display: flex; align-items: center; justify-content: center; gap: .75rem; padding-inline: .5rem; font-size: .79rem; font-weight: 600; }
  .proofs li + li { border-left: 1px solid var(--line); }
  .proofs .icon { color: var(--brown); }
  .section-heading { display: grid; grid-template-columns: 1.35fr 1fr; align-items: end; gap: 3rem; margin-bottom: 3.5rem; }
  .section-heading h2 { margin-bottom: 0; }
  .section-heading__lead { margin: 0; max-width: 28rem; color: var(--muted); font-size: .95rem; }
  .features__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3.75rem; }
  .feature__icon { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; margin-bottom: 1.3rem; color: var(--brown); background: var(--tint); border-radius: 6px; }
  .feature h3 { margin-bottom: .65rem; }
  .feature p, .steps p { margin-bottom: 0; font-size: .9rem; color: var(--muted); }
  .how { background: var(--tint); }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3.75rem; padding: 0; margin: 0; list-style: none; }
  .steps__n { display: block; padding-bottom: 1rem; margin-bottom: 1.3rem; border-bottom: 1px solid #dcd2c7; color: var(--brown); font-size: .8rem; font-weight: 700; }
  .steps h3 { margin-bottom: .65rem; }
  .how__note { margin: 2.4rem 0 0; font-size: .72rem; color: var(--muted); }
  .privacy { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(3rem, 8vw, 8rem); }
  .privacy__visual { min-height: 29rem; display: grid; place-content: center; justify-items: center; background: var(--tint); border: 1px solid var(--line); border-radius: 7px; padding: 2.5rem 1rem 1.5rem; }
  .privacy__device { position: relative; display: flex; flex-direction: column; align-items: center; width: 13.5rem; min-height: 22rem; border: 1px solid #d7cec4; border-radius: 1.7rem; padding: 2.1rem 1.2rem 2.5rem; background: white; box-shadow: 0 12px 30px #5d412710; }
  .privacy__speaker { position: absolute; top: .65rem; left: calc(50% - 1.1rem); height: 3px; width: 2.2rem; border-radius: 4px; background: #ded7cf; }
  .privacy__device-top { display: flex; justify-content: space-between; align-items: center; width: 100%; color: var(--brown); }
  .privacy__device-top > span { font-size: .85rem; font-weight: 800; letter-spacing: -.05em; }
  .privacy__device-top .icon { width: 1rem; height: 1rem; }
  .privacy__lock { width: 3.1rem; margin-top: 2rem; color: var(--brown); }
  .privacy__device p { margin: 1.1rem 0 .5rem; max-width: 11rem; font-size: 1.05rem; line-height: 1.35; font-weight: 600; text-align: center; letter-spacing: -.03em; }
  .privacy__device-note { font-size: .57rem; color: var(--muted); }
  .privacy__audio { display: flex; align-items: center; gap: 4px; height: 45px; margin-top: 1.5rem; }
  .privacy__audio i { width: 3px; border-radius: 3px; background: #ad8b6d; }
  .privacy__home { position: absolute; bottom: .7rem; width: 3rem; height: 3px; background: #ded7cf; border-radius: 3px; }
  .privacy__visual-caption { display: flex; align-items: center; gap: .4rem; margin: 1.25rem 0 0; font-size: .65rem; color: var(--muted); }
  .privacy__visual-caption .icon { width: .95rem; height: .95rem; }
  .body-copy { color: var(--muted); font-size: .95rem; }
  .privacy__points { display: grid; gap: .85rem; margin: 1.75rem 0 0; padding: 0; list-style: none; }
  .privacy__points li { display: flex; align-items: start; gap: .65rem; font-size: .85rem; }
  .privacy__points .icon { color: var(--brown); margin-top: .15rem; }
  .community { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(3rem, 8vw, 8rem); padding-block: clamp(3.5rem, 6vw, 5.5rem); border-block: 1px solid var(--line); }
  .community__license { display: flex; gap: .6rem; align-items: center; margin-top: 1.5rem; color: var(--brown); font-size: .75rem; }
  .community__copy { color: var(--muted); font-size: .95rem; }
  .community__copy .text-link { color: var(--brown); border-bottom: 1px solid #d7c2b1; }
  .faq { display: grid; grid-template-columns: 1fr 1.3fr; gap: 5rem; }
  .faq h2 { font-size: clamp(1.8rem, 2.8vw, 2.5rem); }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq details:first-child { border-top: 1px solid var(--line); }
  .faq summary { display: flex; align-items: center; justify-content: space-between; gap: 1.25rem; padding-block: 1.25rem; list-style: none; cursor: pointer; font-size: .9rem; font-weight: 600; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary:hover { color: var(--brown); }
  .faq summary span { font-size: 1.35rem; font-weight: 400; color: var(--brown); transition: transform 180ms; }
  .faq details[open] summary span { transform: rotate(45deg); }
  .faq details p { padding-right: 2rem; margin-bottom: 1.25rem; color: var(--muted); font-size: .88rem; }
  .closing { background: var(--tint); }
  .closing__inner { display: flex; align-items: center; justify-content: space-between; gap: 3rem; padding-block: 4.5rem; }
  .closing h2 { font-size: clamp(2rem, 3.5vw, 3rem); }
  .closing p:not(.eyebrow) { margin: 0; color: var(--muted); font-size: .88rem; }
  .closing__action { display: flex; flex-direction: column; align-items: center; gap: .8rem; }
  .closing__action > span { color: var(--muted); font-size: .67rem; }
  @media (min-width: 1500px) { h1 { font-size: 4.1rem; } }
  @media (max-width: 1050px) {
    .hero__intro, .section-heading { grid-template-columns: 1.15fr 1fr; gap: 2rem; }
    .hero__actions { column-gap: 1rem; }
    .hero__actions .btn, .hero__actions .text-link { font-size: .75rem; }
    .features__grid, .steps { gap: 2rem; }
    .privacy, .community { gap: 3rem; }
    .faq { gap: 3rem; }
  }
  @media (max-width: 760px) {
    .hero__intro, .section-heading { grid-template-columns: 1fr; gap: 1.4rem; }
    h1 { font-size: clamp(2.65rem, 7.6vw, 3.9rem); }
    .hero__copy { padding-top: 0; }
    .hero__lead { max-width: 34rem; }
    .hero__intro { margin-bottom: 2rem; }
    .hero__actions .btn, .hero__actions .text-link { font-size: .84rem; }
    .hero__landscape { height: 28rem; }
    .hero__image { object-position: 40% 50%; }
    .conversation { right: 1rem; bottom: 1rem; width: 15.5rem; }
    .proofs { grid-template-columns: repeat(2, 1fr); row-gap: 1.4rem; }
    .proofs li { justify-content: flex-start; font-size: .74rem; }
    .proofs li + li { border-left: none; }
    .proofs li:nth-child(even) { padding-left: 1rem; }
    .section-heading { margin-bottom: 2.5rem; }
    .features__grid { grid-template-columns: 1fr; gap: 2rem; }
    .feature { display: grid; grid-template-columns: 2.5rem 1fr; column-gap: 1.15rem; }
    .feature__icon { grid-row: span 2; margin: 0; }
    .feature h3 { margin-top: .3rem; }
    .steps { grid-template-columns: 1fr; gap: 2rem; }
    .steps li { display: grid; grid-template-columns: 2.5rem 1fr; column-gap: 1.15rem; }
    .steps__n { grid-row: span 2; align-self: start; padding: .2rem 0 .75rem; margin: 0; }
    .privacy { grid-template-columns: 1fr; }
    .privacy__copy { grid-row: 1; }
    .privacy__visual { min-height: 27rem; }
    .community, .faq { grid-template-columns: 1fr; gap: 2rem; }
    .faq h2 { margin: 0; }
    .closing__inner { flex-direction: column; align-items: flex-start; gap: 2rem; padding-block: 3.5rem; }
    .closing__action { align-items: flex-start; }
  }
  @media (max-width: 440px) {
    .hero__landscape { height: auto; padding-bottom: 0; background: var(--tint); border: 1px solid var(--line); }
    .hero__image { height: 15rem; object-position: 47% 50%; border-radius: 6px 6px 0 0; }
    .conversation { position: relative; right: auto; bottom: auto; width: calc(100% - 2rem); margin: -2.5rem auto 1rem; box-shadow: 0 4px 18px #17261f0c; border-color: var(--line); }
    .hero__figure figcaption { font-size: .58rem; }
    .hero__figure figcaption > span:last-child { display: none; }
    .proofs li { font-size: .64rem; gap: .5rem; }
    .proofs .icon { width: 1rem; height: 1rem; }
    .hero__actions { gap: .4rem 1rem; }
    .hero__actions .text-link { font-size: .78rem; }
  }
</style>
